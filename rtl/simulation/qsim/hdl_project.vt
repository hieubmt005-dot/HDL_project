// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "03/30/2026 21:15:53"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    clk_divider
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module clk_divider_vlg_sample_tst(
	clk_50M,
	rst,
	sampler_tx
);
input  clk_50M;
input  rst;
output sampler_tx;

reg sample;
time current_time;
always @(clk_50M or rst)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module clk_divider_vlg_check_tst (
	clk_25M,
	clk_60Hz,
	sampler_rx
);
input  clk_25M;
input  clk_60Hz;
input sampler_rx;

reg  clk_25M_expected;
reg  clk_60Hz_expected;

reg  clk_25M_prev;
reg  clk_60Hz_prev;

reg  clk_25M_expected_prev;
reg  clk_60Hz_expected_prev;

reg  last_clk_25M_exp;
reg  last_clk_60Hz_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	clk_25M_prev = clk_25M;
	clk_60Hz_prev = clk_60Hz;
end

// update expected /o prevs

always @(trigger)
begin
	clk_25M_expected_prev = clk_25M_expected;
	clk_60Hz_expected_prev = clk_60Hz_expected;
end



// expected clk_25M
initial
begin
	clk_25M_expected = 1'bX;
end 

// expected clk_60Hz
initial
begin
	clk_60Hz_expected = 1'bX;
end 
// generate trigger
always @(clk_25M_expected or clk_25M or clk_60Hz_expected or clk_60Hz)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected clk_25M = %b | expected clk_60Hz = %b | ",clk_25M_expected_prev,clk_60Hz_expected_prev);
	$display("| real clk_25M = %b | real clk_60Hz = %b | ",clk_25M_prev,clk_60Hz_prev);
`endif
	if (
		( clk_25M_expected_prev !== 1'bx ) && ( clk_25M_prev !== clk_25M_expected_prev )
		&& ((clk_25M_expected_prev !== last_clk_25M_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_25M :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_25M_expected_prev);
		$display ("     Real value = %b", clk_25M_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_clk_25M_exp = clk_25M_expected_prev;
	end
	if (
		( clk_60Hz_expected_prev !== 1'bx ) && ( clk_60Hz_prev !== clk_60Hz_expected_prev )
		&& ((clk_60Hz_expected_prev !== last_clk_60Hz_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_60Hz :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_60Hz_expected_prev);
		$display ("     Real value = %b", clk_60Hz_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_clk_60Hz_exp = clk_60Hz_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module clk_divider_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk_50M;
reg rst;
// wires                                               
wire clk_25M;
wire clk_60Hz;

wire sampler;                             

// assign statements (if any)                          
clk_divider i1 (
// port map - connection between master ports and signals/registers   
	.clk_25M(clk_25M),
	.clk_50M(clk_50M),
	.clk_60Hz(clk_60Hz),
	.rst(rst)
);

// clk_50M
always
begin
	clk_50M = 1'b0;
	clk_50M = #20000 1'b1;
	#20000;
end 

// rst
initial
begin
	rst = 1'b0;
end 

clk_divider_vlg_sample_tst tb_sample (
	.clk_50M(clk_50M),
	.rst(rst),
	.sampler_tx(sampler)
);

clk_divider_vlg_check_tst tb_out(
	.clk_25M(clk_25M),
	.clk_60Hz(clk_60Hz),
	.sampler_rx(sampler)
);
endmodule

